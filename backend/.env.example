# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# auto = use Claude if ANTHROPIC_API_KEY is set, otherwise offline mock AI
KHUTWA_AI_MODE=auto
CLAUDE_MODEL=claude-opus-5-5
# local = JSON files in backend/data (no setup). firestore = Google Firestore.
KHUTWA_STORE=local
# demo = X-User-Id header (defaults to the demo patient). firebase = verify Firebase ID tokens.
KHUTWA_AUTH=demo
# Path to a Firebase service-account JSON (only for firestore / firebase auth)
GOOGLE_APPLICATION_CREDENTIALS=
