# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Or a free Google AI Studio key (used when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else offline mock AI
KHUTWA_AI_MODE=auto
CLAUDE_MODEL=claude-opus-5-5
# local = JSON files in backend/data (no setup). firestore = Google Firestore.
KHUTWA_STORE=local
# demo = X-User-Id header (defaults to the demo patient). firebase = verify Firebase ID tokens.
KHUTWA_AUTH=demo
# Path to a Firebase service-account JSON (only for firestore / firebase auth)
GOOGLE_APPLICATION_CREDENTIALS=
